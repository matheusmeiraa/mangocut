{
  "name": "mangocut",
  "version": "1.0.0",
  "description": "Motor de timeline open source em TypeScript: lê, valida, repara e gera projetos no formato draft_content.json / draft_info.json da família CapCut, com interpolação de keyframes Bézier cúbica em float32",
  "keywords": [
    "video-editor",
    "timeline",
    "keyframes",
    "cubic-bezier",
    "draft_content",
    "capcut",
    "cli"
  ],
  "license": "MIT",
  "author": "Matheus Meira",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/matheusmeiraa/mangocut.git"
  },
  "homepage": "https://github.com/matheusmeiraa/mangocut#readme",
  "bugs": {
    "url": "https://github.com/matheusmeiraa/mangocut/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "mangocut": "./bin/mangocut.js"
  },
  "files": [
    "bin",
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --test tests/*.test.ts",
    "prepare": "npm run build",
    "build:ios-engine": "esbuild src/index.ts --bundle --format=iife --global-name=MangoCUT --platform=neutral --target=safari16 --legal-comments=none --outfile=ios/Generated/mangocut-engine.js"
  },
  "devDependencies": {
    "@types/node": "~22.18.0",
    "esbuild": "~0.25.12",
    "typescript": "~5.9.2"
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
